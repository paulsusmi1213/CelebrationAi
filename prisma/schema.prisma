// Celebration & Event Planner - Prisma Schema
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ORGANIZER
  ADMIN
}

enum EventType {
  WEDDING
  BIRTHDAY
  COMMUNITY
  CUSTOM
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum VendorStatus {
  PENDING
  RESEARCHING
  CONTACTED
  BOOKED
  DECLINED
}

enum Phase {
  SIX_PLUS_MONTHS
  THREE_TO_FIVE_MONTHS
  ONE_TO_TWO_MONTHS
  TWO_TO_FOUR_WEEKS
  ONE_WEEK_OUT
  DAY_OF
  POST_EVENT
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  role          Role      @default(USER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  events        Event[]
  auditLogs     AuditLog[]

  @@index([email])
}

model Event {
  id               String       @id @default(uuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  eventType        EventType    @default(CUSTOM)
  customType       String?
  eventDate        DateTime
  location         String
  guestCount       Int
  totalBudget      Decimal      @db.Decimal(12, 2)
  currency         String       @default("USD")
  themePreferences String?      @db.Text
  specialRequests  String?      @db.Text
  planSummary      String?      @db.Text
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  budgetItems      BudgetItem[]
  timelineTasks    TimelineTask[]
  vendors          VendorChecklist[]
  bespokeIdeas     BespokeIdea[]
  copilotHistory   CopilotChat[]

  @@index([userId])
  @@index([eventDate])
}

model BudgetItem {
  id              String   @id @default(uuid())
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category        String
  allocatedAmount Decimal  @db.Decimal(12, 2)
  actualSpent     Decimal  @default(0.00) @db.Decimal(12, 2)
  percentage      Float
  isContingency   Boolean  @default(false)
  costSavingTip   String?  @db.Text
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([eventId])
}

model TimelineTask {
  id                     String   @id @default(uuid())
  eventId                String
  event                  Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  phase                  Phase
  title                  String
  description            String   @db.Text
  targetDateDescription  String
  priority               Priority @default(MEDIUM)
  isCompleted            Boolean  @default(false)
  category               String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([eventId, phase])
}

model VendorChecklist {
  id                 String       @id @default(uuid())
  eventId            String
  event              Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vendorType         String
  companyName        String?
  estimatedCost      Decimal      @db.Decimal(12, 2)
  status             VendorStatus @default(PENDING)
  priority           Priority     @default(MEDIUM)
  questionsToAsk     Json         // Array of strings
  contractWatchouts  Json         // Array of strings
  depositPaid        Decimal?     @db.Decimal(12, 2)
  finalPaymentDue    DateTime?
  contactEmail       String?
  contactPhone       String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([eventId])
}

model BespokeIdea {
  id                  String   @id @default(uuid())
  eventId             String
  event               Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title               String
  category            String
  description         String   @db.Text
  estimatedCostImpact String
  createdAt           DateTime @default(now())

  @@index([eventId])
}

model CopilotChat {
  id           String   @id @default(uuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  senderRole   String   // 'user' | 'assistant'
  message      String   @db.Text
  changesDelta Json?
  createdAt    DateTime @default(now())

  @@index([eventId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

