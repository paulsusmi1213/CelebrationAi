# ==============================================================================
# CelebrationAI Environment Configuration
# ==============================================================================

# LLM Integration (Google Gemini 1.5 Pro / Flash)
GEMINI_API_KEY="your-gemini-api-key-here"

# Database Connection (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://postgres:password@localhost:5432/celebration_planner?schema=public"

# Authentication (NextAuth.js v5 / Auth.js)
AUTH_SECRET="your-32-byte-base64-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional OAuth Providers
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# Anti-Abuse Rate Limiting (Upstash Redis)
# If left empty, system automatically uses high-performance in-memory sliding window fallback
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Node Environment
NODE_ENV="development"

